<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>
        <%= etiqueta %>
    </title>
    <%- include('partials/head') %>
</head>

<body class="login">
    <!--BARRA DE NAVEGACION-->

    <%- include('partials/navegation') %>

    <!--En caso que el codigo este desordenado usamos la tecla Shit+alt+f y nos formatea codigo-->

    <main class="container vh-100 d-flex flex-column justify-content-center align-items-center">

    <!--TITULO DE VISTA-->

<section class="text-center mb-4">
            <h1 class="h3 text-dark">Inicio de Sesion</h1>
</section>

    <!--DISEÑO DE LA TARJETA LOGIN-->

<div class="login-card p-4 bg-white rounded shadow-lg" style="width: 400px;">

    <!--FORMULARIO PRINCIPAL-->
            <form action="/login" method="post">

                    <% if (mensaje) { %>
                     <div class="error"><%= mensaje %></div>
                    <% } %>

<div class="mb-3">
            <input type="text" class="form-control" name="usuario" placeholder="usuario" required>
</div>

<div class="mb-3">
            <input type="password" class="form-control" name="contraseña" placeholder="contraseña" required>
</div>

<div class="d-flex justify-content-center gap-2 flex-wrap">
    <a href="/registro" class="btn btn-outline-dark rounded-pill">crear usuario</a>
    <button type="submit" class="btn rounded-pill" style="background-color: #000000; color: white;">ingresar</button>
    <button type="reset" class="btn rounded-pill" style="background-color: #4a4a4a; color: white;">Limpiar</button>
</div>

    <!-- Enlaces de recuperación -->
<div class="links text-center mt-3 d-flex flex-column gap-1">
    <a href="/recuperar-password" class="text-decoration-none text-dark fw-bold">Restablecer contraseña</a>
    <a href="/recordar-usuario" class="text-decoration-none text-dark fw-bold">Recordar Usuario</a>
</div>
        </form>

    </div>

</main>

             <%- include('partials/footer') %>

             <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>